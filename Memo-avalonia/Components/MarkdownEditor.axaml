<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Memo.Components.MarkdownEditor">
  <UserControl.Resources>
    <StreamGeometry x:Key="MdListIcon">M4,10.5C3.17,10.5 2.5,11.17 2.5,12C2.5,12.83 3.17,13.5 4,13.5C4.83,13.5 5.5,12.83 5.5,12C5.5,11.17 4.83,10.5 4,10.5M4,4.5C3.17,4.5 2.5,5.17 2.5,6C2.5,6.83 3.17,7.5 4,7.5C4.83,7.5 5.5,6.83 5.5,6C5.5,5.17 4.83,4.5 4,4.5M4,16.5C3.17,16.5 2.5,17.17 2.5,18C2.5,18.83 3.17,19.5 4,19.5C4.83,19.5 5.5,18.83 5.5,18C5.5,17.17 4.83,16.5 4,16.5M8,19H22V17H8V19M8,13H22V11H8V13M8,5V7H22V5H8Z</StreamGeometry>
    <StreamGeometry x:Key="MdLinkIcon">M10.59,13.41C11,13.8 11,14.4 10.59,14.82L8.82,16.59C7.26,18.15 4.73,18.15 3.17,16.59C1.61,15.03 1.61,12.5 3.17,10.94L6.71,7.4C8.27,5.84 10.8,5.84 12.36,7.4C12.77,7.81 12.77,8.44 12.36,8.83C11.97,9.22 11.34,9.22 10.95,8.83C10.17,8.05 8.9,8.05 8.12,8.83L4.58,12.37C3.8,13.15 3.8,14.42 4.58,15.2C5.36,15.98 6.63,15.98 7.41,15.2L9.18,13.41C9.57,13.02 10.2,13.02 10.59,13.41M20.83,7.41C22.39,8.97 22.39,11.5 20.83,13.06L17.29,16.6C15.73,18.16 13.2,18.16 11.64,16.6C11.23,16.19 11.23,15.56 11.64,15.17C12.03,14.78 12.66,14.78 13.05,15.17C13.83,15.95 15.1,15.95 15.88,15.17L19.42,11.63C20.2,10.85 20.2,9.58 19.42,8.8C18.64,8.02 17.37,8.02 16.59,8.8L14.82,10.59C14.43,10.98 13.8,10.98 13.41,10.59C13,10.2 13,9.6 13.41,9.18L15.18,7.41C16.74,5.85 19.27,5.85 20.83,7.41Z</StreamGeometry>
    <StreamGeometry x:Key="MdImageIcon">M21,19V5C21,3.9 20.1,3 19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19M8.5,13.5L11,16.51L14.5,12L19,18H5L8.5,13.5Z</StreamGeometry>
    <StreamGeometry x:Key="MdMoreIcon">M6,10C4.9,10 4,10.9 4,12C4,13.1 4.9,14 6,14C7.1,14 8,13.1 8,12C8,10.9 7.1,10 6,10M18,10C16.9,10 16,10.9 16,12C16,13.1 16.9,14 18,14C19.1,14 20,13.1 20,12C20,10.9 19.1,10 18,10M12,10C10.9,10 10,10.9 10,12C10,13.1 10.9,14 12,14C13.1,14 14,13.1 14,12C14,10.9 13.1,10 12,10Z</StreamGeometry>
    <StreamGeometry x:Key="MdSaveIcon">F1M5.25,3.5H16.7L20.5,7.3V18.75C20.5,19.72 19.72,20.5 18.75,20.5H5.25C4.28,20.5 3.5,19.72 3.5,18.75V5.25C3.5,4.28 4.28,3.5 5.25,3.5ZM5.25,5.25V18.75H7.25V13.25C7.25,12.56 7.81,12 8.5,12H15.5C16.19,12 16.75,12.56 16.75,13.25V18.75H18.75V8.03L15.97,5.25H15.75V8.75C15.75,9.44 15.19,10 14.5,10H7.5C6.81,10 6.25,9.44 6.25,8.75V5.25ZM8,5.25V8.25H14V5.25ZM9,13.75V18.75H15V13.75Z</StreamGeometry>
    <StreamGeometry x:Key="MdNewIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.MarkdownEditorSurface"><Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="Border.MarkdownEditorSurface:focus-within"><Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/></Style>
    <Style Selector="Border.MarkdownEditorSurface.borderless"><Setter Property="Background" Value="{StaticResource BgPrimaryBrush}"/></Style>
    <Style Selector="Border.MarkdownEditorSurface.borderless:focus-within"><Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Style>
    <Style Selector="Button.MarkdownToolButton"><Setter Property="Width" Value="29"/><Setter Property="Height" Value="29"/><Setter Property="MinWidth" Value="29"/><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource IconDefaultBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.MarkdownToolButton:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource BgHoverBrush}"/></Style>
    <Style Selector="Button.MarkdownToolButton.formatActive /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource BgHoverBrush}"/></Style>
    <Style Selector="Button.MarkdownToolButton.formatActive"><Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/></Style>
    <Style Selector="Button.MarkdownToolButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.MarkdownToolButton.saveAction /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}"/></Style>
    <Style Selector="Button.MarkdownToolButton.saveAction"><Setter Property="Foreground" Value="{StaticResource SuccessHoverBrush}"/></Style>
    <Style Selector="TextBox.MarkdownTableCellInput">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="TextBox.MarkdownTableCellInput /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.MarkdownTableCellInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.MarkdownTableCellInput:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.MarkdownTableCellInput:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </UserControl.Styles>
  <Border x:Name="_surface" Classes="MarkdownEditorSurface" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Border x:Name="_toolbar" Height="36" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="5,3">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel x:Name="_formatToolbar" Orientation="Horizontal" Spacing="1">
            <Button x:Name="_boldButton" Classes="MarkdownToolButton" Tag="Bold" Click="OnFormatClick" ToolTip.Tip="粗体 (Ctrl+B)"><TextBlock Text="B" FontSize="16" FontWeight="Bold"/></Button>
            <Button x:Name="_italicButton" Classes="MarkdownToolButton" Tag="Italic" Click="OnFormatClick" ToolTip.Tip="斜体 (Ctrl+I)"><TextBlock Text="I" FontSize="16" FontStyle="Italic"/></Button>
            <Button Classes="MarkdownToolButton" Tag="BulletList" Click="OnFormatClick" ToolTip.Tip="无序列表"><PathIcon Data="{StaticResource MdListIcon}" Width="15" Height="15"/></Button>
            <Button Classes="MarkdownToolButton" Click="OnLinkClick" ToolTip.Tip="插入或编辑链接 (Ctrl+K)"><PathIcon Data="{StaticResource MdLinkIcon}" Width="15" Height="15"/></Button>
            <Button Classes="MarkdownToolButton" Click="OnLocalImageClick" ToolTip.Tip="插入本地图片"><PathIcon Data="{StaticResource MdImageIcon}" Width="15" Height="15"/></Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1">
            <Button x:Name="_moreButton" Classes="MarkdownToolButton" ToolTip.Tip="更多格式"><PathIcon Data="{StaticResource MdMoreIcon}" Width="16" Height="16"/><Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="标题" Tag="Heading" Click="OnFormatMenuClick"/><MenuItem x:Name="_strikeMenuItem" Header="删除线" Tag="Strikethrough" ToggleType="CheckBox" Click="OnFormatMenuClick"/><MenuItem Header="有序列表" Tag="OrderedList" Click="OnFormatMenuClick"/><MenuItem Header="任务列表" Tag="TaskList" Click="OnFormatMenuClick"/><MenuItem Header="引用" Tag="Quote" Click="OnFormatMenuClick"/><MenuItem x:Name="_codeMenuItem" Header="行内代码" Tag="InlineCode" ToggleType="CheckBox" Click="OnFormatMenuClick"/><MenuItem Header="代码块" Tag="CodeBlock" Click="OnFormatMenuClick"/><MenuItem Header="表格" Tag="Table" Click="OnFormatMenuClick"/><MenuItem Header="分隔线" Tag="HorizontalRule" Click="OnFormatMenuClick"/><Separator/><MenuItem Header="网络图片" Click="OnRemoteImageClick"/><MenuItem Header="编辑 Markdown 源码" Click="OnEditSourceClick"/>
            </MenuFlyout></Button.Flyout></Button>
            <Button x:Name="_saveButton" Classes="MarkdownToolButton saveAction" Click="OnSaveClick" ToolTip.Tip="立即保存 (Ctrl+Enter)"><PathIcon Data="{StaticResource MdSaveIcon}" Width="16" Height="16"/></Button>
            <Button x:Name="_newButton" Classes="MarkdownToolButton" Click="OnNewClick" ToolTip.Tip="新建备忘录" IsVisible="False"><PathIcon Data="{StaticResource MdNewIcon}" Width="16" Height="16"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" MinHeight="58">
        <ae:TextEditor x:Name="_editor" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif" FontSize="13" WordWrap="True" ShowLineNumbers="False" IsReadOnly="False" IsEnabled="True" Focusable="True" Padding="11,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TextChanged="OnEditorTextChanged" PointerPressed="OnEditorPointerPressed"/>
        <TextBlock x:Name="_watermark" Text="写点什么…" Margin="13,11" Foreground="{StaticResource TextDisabledBrush}" IsHitTestVisible="False"/>
        <Border x:Name="_statusBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="7,3" CornerRadius="6" Background="{StaticResource BgTertiaryBrush}" IsHitTestVisible="False" Opacity="0"><TextBlock x:Name="_statusText" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/></Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
