<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Memo.Components.Dialogs.LinkEditDialog" Title="编辑链接" Width="420" Height="220" CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="18">
    <TextBlock Text="链接文本" Foreground="{StaticResource TextSecondaryBrush}"/><TextBox x:Name="_labelBox" Grid.Row="1" Margin="0,5,0,10"/>
    <TextBlock Grid.Row="2" Text="地址" Foreground="{StaticResource TextSecondaryBrush}"/><TextBox x:Name="_urlBox" Grid.Row="3" Margin="0,5,0,10" Watermark="https://" KeyDown="OnKeyDown"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="取消" MinWidth="76" Click="OnCancel"/><Button Content="确认" MinWidth="76" Background="{StaticResource AccentPrimaryBrush}" Foreground="White" Click="OnConfirm"/></StackPanel>
  </Grid>
</Window>
