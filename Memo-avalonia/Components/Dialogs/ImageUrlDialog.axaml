<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Memo.Components.Dialogs.ImageUrlDialog"
        Title="插入网络图片"
        Width="380" Height="174"
        MinWidth="320" MinHeight="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Window.Styles>
    <Style Selector="TextBox.ImageUrlInput">
      <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="TextBox.ImageUrlInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
    </Style>
    <Style Selector="Button.DialogButton">
      <Setter Property="MinWidth" Value="74"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.DialogButton.secondary">
      <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.DialogButton.primary">
      <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.DialogButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </Window.Styles>

  <Border Background="{StaticResource BgPrimaryBrush}"
          BorderBrush="{StaticResource BorderDefaultBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="18">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <TextBlock Text="网络图片地址"
                 FontWeight="SemiBold"
                 FontSize="14"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 PointerPressed="OnTitleBarPointerPressed"/>
      <TextBox Grid.Row="1"
               x:Name="_urlBox"
               Classes="ImageUrlInput"
               Margin="0,10"
               Watermark="https://example.com/image.png"
               KeyDown="OnUrlKeyDown"/>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="_errorText"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource DangerPrimaryBrush}"
                   FontSize="11.5"
                   Opacity="0"
                   Text="请输入有效的 HTTPS 图片地址"/>
        <Button Grid.Column="1" Classes="DialogButton secondary" Margin="0,0,8,0" Content="取消" Click="OnCancelClick"/>
        <Button Grid.Column="2" Classes="DialogButton primary" Content="插入" Click="OnInsertClick"/>
      </Grid>
    </Grid>
  </Border>
</Window>
