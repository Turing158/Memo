<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:Memo.Components"
        x:Class="Memo.Components.Dialogs.CloseActionDialog"
        Width="330" Height="230"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Border x:Name="_dialogShell"
          Background="{StaticResource SurfacePrimaryBrush}"
          BorderBrush="{StaticResource BorderEmphasisBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="18"
          RenderTransformOrigin="0.5%,0.5%">
    <Border.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <Grid RowDefinitions="*,Auto">
      <StackPanel Spacing="12">
        <StackPanel Spacing="8" PointerPressed="OnTitleBarPointerPressed">
          <TextBlock Text="关闭按钮操作" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="点击右上角关闭按钮时，要最小化到托盘还是直接关闭应用？" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <comp:SegmentedSelector x:Name="_closeActionSelector"
                                AutomationProperties.Name="关闭按钮操作"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Height="32" Padding="14,0" CornerRadius="8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick"/>
        <Button Content="确认" Height="32" Padding="14,0" CornerRadius="8" Background="{StaticResource AccentPrimaryBrush}" Foreground="{StaticResource TextOnAccentBrush}" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnConfirmClick"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
