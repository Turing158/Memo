<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Markdown.Avalonia.Full"
             xmlns:ct="using:ColorTextBlock.Avalonia"
             xmlns:mdControls="using:Markdown.Avalonia.Controls"
             x:Class="Memo.Components.MarkdownEditor">
  <UserControl.Resources>
    <StreamGeometry x:Key="MdEditIcon">M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87L20.71,7.04Z</StreamGeometry>
    <StreamGeometry x:Key="MdPreviewIcon">M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17M12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9Z</StreamGeometry>
    <StreamGeometry x:Key="MdListIcon">M4,10.5C3.17,10.5 2.5,11.17 2.5,12C2.5,12.83 3.17,13.5 4,13.5C4.83,13.5 5.5,12.83 5.5,12C5.5,11.17 4.83,10.5 4,10.5M4,4.5C3.17,4.5 2.5,5.17 2.5,6C2.5,6.83 3.17,7.5 4,7.5C4.83,7.5 5.5,6.83 5.5,6C5.5,5.17 4.83,4.5 4,4.5M4,16.5C3.17,16.5 2.5,17.17 2.5,18C2.5,18.83 3.17,19.5 4,19.5C4.83,19.5 5.5,18.83 5.5,18C5.5,17.17 4.83,16.5 4,16.5M8,19H22V17H8V19M8,13H22V11H8V13M8,5V7H22V5H8Z</StreamGeometry>
    <StreamGeometry x:Key="MdLinkIcon">M10.59,13.41C11,13.8 11,14.4 10.59,14.82L8.82,16.59C7.26,18.15 4.73,18.15 3.17,16.59C1.61,15.03 1.61,12.5 3.17,10.94L6.71,7.4C8.27,5.84 10.8,5.84 12.36,7.4C12.77,7.81 12.77,8.44 12.36,8.83C11.97,9.22 11.34,9.22 10.95,8.83C10.17,8.05 8.9,8.05 8.12,8.83L4.58,12.37C3.8,13.15 3.8,14.42 4.58,15.2C5.36,15.98 6.63,15.98 7.41,15.2L9.18,13.41C9.57,13.02 10.2,13.02 10.59,13.41M20.83,7.41C22.39,8.97 22.39,11.5 20.83,13.06L17.29,16.6C15.73,18.16 13.2,18.16 11.64,16.6C11.23,16.19 11.23,15.56 11.64,15.17C12.03,14.78 12.66,14.78 13.05,15.17C13.83,15.95 15.1,15.95 15.88,15.17L19.42,11.63C20.2,10.85 20.2,9.58 19.42,8.8C18.64,8.02 17.37,8.02 16.59,8.8L14.82,10.59C14.43,10.98 13.8,10.98 13.41,10.59C13,10.2 13,9.6 13.41,9.18L15.18,7.41C16.74,5.85 19.27,5.85 20.83,7.41Z</StreamGeometry>
    <StreamGeometry x:Key="MdImageIcon">M21,19V5C21,3.9 20.1,3 19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19M8.5,13.5L11,16.51L14.5,12L19,18H5L8.5,13.5Z</StreamGeometry>
    <StreamGeometry x:Key="MdMoreIcon">M6,10C4.9,10 4,10.9 4,12C4,13.1 4.9,14 6,14C7.1,14 8,13.1 8,12C8,10.9 7.1,10 6,10M18,10C16.9,10 16,10.9 16,12C16,13.1 16.9,14 18,14C19.1,14 20,13.1 20,12C20,10.9 19.1,10 18,10M12,10C10.9,10 10,10.9 10,12C10,13.1 10.9,14 12,14C13.1,14 14,13.1 14,12C14,10.9 13.1,10 12,10Z</StreamGeometry>
    <StreamGeometry x:Key="MdSaveIcon">M17,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V7L17,3M12,19C10.34,19 9,17.66 9,16C9,14.34 10.34,13 12,13C13.66,13 15,14.34 15,16C15,17.66 13.66,19 12,19M15,9H5V5H15V9Z</StreamGeometry>
    <StreamGeometry x:Key="MdNewIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.MarkdownEditorSurface">
      <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Transitions"><Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource MotionStandardDuration}" Easing="CubicEaseOut"/>
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionStandardDuration}" Easing="CubicEaseOut"/>
      </Transitions></Setter>
    </Style>
    <Style Selector="Border.MarkdownEditorSurface:focus-within">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
    </Style>
    <Style Selector="Button.MarkdownToolButton">
      <Setter Property="Width" Value="29"/><Setter Property="Height" Value="29"/>
      <Setter Property="MinWidth" Value="29"/><Setter Property="MinHeight" Value="29"/>
      <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource IconDefaultBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.MarkdownToolButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions"><Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}"/>
      </Transitions></Setter>
    </Style>
    <Style Selector="Button.MarkdownToolButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
    </Style>
    <Style Selector="Button.MarkdownToolButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
    </Style>
    <Style Selector="Button.MarkdownToolButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.MarkdownToolButton.accent">
      <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBox.MarkdownSource">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="SelectionForegroundBrush" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="21"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI, monospace"/>
      <Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="11,9"/>
    </Style>
    <Style Selector="TextBox.MarkdownSource:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer ct|CTextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer ct|CTextBlock.Paragraph">
      <Setter Property="Margin" Value="0,3,0,8"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer ct|CTextBlock.Heading1">
      <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,9,0,7"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer ct|CTextBlock.Heading2">
      <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,8,0,6"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer ct|CTextBlock.Heading3">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,7,0,5"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer ct|CHyperlink">
      <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer ct|CCode">
      <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
      <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer Border.CodeBlock">
      <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,0,9"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer Border.Blockquote">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="CornerRadius" Value="0,6,6,0"/>
      <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,5,0,9"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer Grid.Table">
      <Setter Property="Margin" Value="0,5,0,9"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer Grid.Table > Border">
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer Border.TableHeader">
      <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer Image">
      <Setter Property="MaxWidth" Value="720"/><Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="md|MarkdownScrollViewer mdControls|Rule">
      <Setter Property="Foreground" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="Margin" Value="0,9"/>
    </Style>
  </UserControl.Styles>

  <Border x:Name="_surface" Classes="MarkdownEditorSurface" ClipToBounds="True">
    <Grid RowDefinitions="36,*">
      <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
              Padding="5,3">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button x:Name="_modeButton" Grid.Column="0" Classes="MarkdownToolButton accent"
                  Click="OnModeClick" ToolTip.Tip="预览 Markdown">
            <PathIcon x:Name="_modeIcon" Data="{StaticResource MdPreviewIcon}" Width="15" Height="15"/>
          </Button>

          <StackPanel x:Name="_formatToolbar" Grid.Column="1" Orientation="Horizontal" Spacing="1" Margin="3,0">
            <Button Classes="MarkdownToolButton" Tag="Bold" Click="OnFormatClick" ToolTip.Tip="粗体 (Ctrl+B)">
              <TextBlock Text="B" FontWeight="Bold" FontSize="14"/>
            </Button>
            <Button Classes="MarkdownToolButton" Tag="Italic" Click="OnFormatClick" ToolTip.Tip="斜体 (Ctrl+I)">
              <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="15"/>
            </Button>
            <Button Classes="MarkdownToolButton" Tag="BulletList" Click="OnFormatClick" ToolTip.Tip="无序列表">
              <PathIcon Data="{StaticResource MdListIcon}" Width="15" Height="15"/>
            </Button>
            <Button Classes="MarkdownToolButton" Tag="Link" Click="OnFormatClick" ToolTip.Tip="插入链接 (Ctrl+K)">
              <PathIcon Data="{StaticResource MdLinkIcon}" Width="15" Height="15"/>
            </Button>
            <Button Classes="MarkdownToolButton" Click="OnLocalImageClick" ToolTip.Tip="插入本地图片">
              <PathIcon Data="{StaticResource MdImageIcon}" Width="15" Height="15"/>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1">
            <Button x:Name="_moreButton" Classes="MarkdownToolButton" ToolTip.Tip="更多格式">
              <PathIcon Data="{StaticResource MdMoreIcon}" Width="16" Height="16"/>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="标题" Tag="Heading" Click="OnFormatMenuClick"/>
                  <MenuItem Header="删除线" Tag="Strikethrough" Click="OnFormatMenuClick"/>
                  <MenuItem Header="有序列表" Tag="OrderedList" Click="OnFormatMenuClick"/>
                  <MenuItem Header="任务列表" Tag="TaskList" Click="OnFormatMenuClick"/>
                  <MenuItem Header="引用" Tag="Quote" Click="OnFormatMenuClick"/>
                  <MenuItem Header="行内代码" Tag="InlineCode" Click="OnFormatMenuClick"/>
                  <MenuItem Header="代码块" Tag="CodeBlock" Click="OnFormatMenuClick"/>
                  <MenuItem Header="表格" Tag="Table" Click="OnFormatMenuClick"/>
                  <MenuItem Header="分隔线" Tag="HorizontalRule" Click="OnFormatMenuClick"/>
                  <Separator/>
                  <MenuItem Header="网络图片" Click="OnRemoteImageClick"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="_saveButton" Classes="MarkdownToolButton accent" Click="OnSaveClick" ToolTip.Tip="保存">
              <PathIcon Data="{StaticResource MdSaveIcon}" Width="15" Height="15"/>
            </Button>
            <Button x:Name="_newButton" Classes="MarkdownToolButton accent" Click="OnNewClick" ToolTip.Tip="新建备忘录" IsVisible="False">
              <PathIcon Data="{StaticResource MdNewIcon}" Width="16" Height="16"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" x:Name="_contentHost" MinHeight="58">
        <TextBox x:Name="_editor" Classes="MarkdownSource"
                 Watermark="用 Markdown 写点什么..."
                 TextChanged="OnEditorTextChanged"
                 KeyDown="OnEditorKeyDown"/>
        <md:MarkdownScrollViewer x:Name="_preview"
                                 MarkdownStyleName="FluentTheme"
                                 Margin="11,7"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionEnabled="True"
                                 SelectionBrush="{StaticResource AccentMutedBrush}"
                                 IsVisible="False"
                                 Opacity="0"
                                 DoubleTapped="OnPreviewDoubleTapped"/>
        <Border x:Name="_statusBadge"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="7" Padding="7,3" CornerRadius="6"
                Background="{StaticResource BgTertiaryBrush}"
                IsHitTestVisible="False" Opacity="0">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionFastDuration}"/>
            </Transitions>
          </Border.Transitions>
          <TextBlock x:Name="_statusText" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
